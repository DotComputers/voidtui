<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!--
      Required because void is a Bun-compiled binary that extracts and dlopen()s
      a bundled OpenTUI native renderer library at runtime. The embedded .dylib
      has a different signing identity than the parent binary (it ships
      pre-signed by the upstream OpenTUI / Bun maintainers), which the hardened
      runtime's strict library validation rejects.

      This entitlement is the documented Apple-supported way to allow loading
      libraries with mismatched team IDs. It's used by Electron, Bun, Node
      single-executable binaries, and most apps that bundle third-party native
      libraries. Notarization accepts binaries signed with it.
    -->
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>

    <!--
      Bun JIT-compiles JavaScript at runtime. Hardened runtime blocks JIT
      memory allocation by default and kills the process with SIGTRAP from
      pthread_jit_write_protect_np. These two entitlements are the standard
      Bun / JSC / V8 / quickjs combo for permitting JIT on macOS.
    -->
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>
</dict>
</plist>
